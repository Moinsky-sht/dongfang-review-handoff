# 模型审阅凭据（可选）
#
# 不配置也能用：格式/语言/引文三类规则审阅完全离线，页面里把「模型深度审阅」
# 关掉即可（默认未配置时也不会去请求模型）。
#
# 启用模型审阅：到自己的火山方舟控制台创建 API Key，填到下面（或直接设环境变量），
# 真实 Key 只放在本地环境变量 / 服务器进程环境里，不要提交到代码库、不要写进 README。
#
# Linux/macOS:  export ARK_API_KEY=xxxx
# Windows CMD:  set ARK_API_KEY=xxxx
# PowerShell:   $env:ARK_API_KEY="xxxx"

ARK_API_KEY=

# ---- 以下为可选 ----
# 默认 https://ark.cn-beijing.volces.com/api/v3
# ARK_BASE_URL=
# 默认 deepseek-v4-1-flash-260910
# ARK_MODEL=
# 多个接入点映射（JSON），一般不用配
# ARK_MODEL_ENDPOINTS=
# 稿件并发与模型请求池并发（小机器建议 1–2）
# DSH_REVIEW_WORKERS=2
# DSH_ARK_POOL_CONCURRENCY=2
